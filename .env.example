# ==============================================================================
# Environment Variables Template
# All variables are declared by name only with no default or hardcoded secrets.
# Copy this file to .env (or backend/.env, frontend/.env.local) and supply real values.
# ==============================================================================

# Application
APP_NAME=
APP_VERSION=
DEBUG=
ENVIRONMENT=

# Authentication & Security (SECRET_KEY is required; app fails to start if missing)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=

# API & CORS
API_V1_STR=
BACKEND_CORS_ORIGINS=

# PostgreSQL Database
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Google Gemini AI
GOOGLE_API_KEY=
GEMINI_MODEL=

# ChromaDB Vector Store
CHROMA_HOST=
CHROMA_PORT=
CHROMA_COLLECTION_NAME=

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=
